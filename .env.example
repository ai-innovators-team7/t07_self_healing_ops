# ============================================================================
# AI Innovators Expedition — London Hackathon Starter (.env.example)
# Copy to .env and fill in your Google Cloud project ID and Table Seed Pack:
#   cp .env.example .env
# Format: KEY=value, no quotes, no spaces around '=' (the Makefile reads this file).
# ============================================================================

# 1. Google Cloud Project (Sandbox Project or Own-Org Project)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# 2. Gemini Model & Endpoint Location
# IMPORTANT: Gemini 3.8 Flash requires location=global on Vertex AI.
# Never hardcode model IDs in code and never use -latest aliases.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# 3. Vertex AI Agent Runtime (Reasoning Engine) Deployment Region
# Supported GA Europe regions: europe-west1, europe-west2
AGENT_RUNTIME_LOCATION=europe-west1

# 4. Cloud Storage Staging Bucket for Agent Runtime packaging & Seed Pack files
# Leave empty to use the default gs://<GOOGLE_CLOUD_PROJECT>-hackathon-staging
# (create it once: see README step 3).
STAGING_BUCKET=

# 5. Selected Table Seed Pack (t01 .. t10, or t00_example for smoke testing)
# Leave empty to fall back to the minimal hello-world starter agent.
SEED_PACK=t08

# 6. BigQuery Dataset Location (default: EU)
BQ_LOCATION=EU
